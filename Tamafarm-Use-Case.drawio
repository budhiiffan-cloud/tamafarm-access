        <mxCell id="27" value="Asosiasi: garis utuh menghubungkan aktor dengan tujuan pengguna.&#10;Sumber: frontend/src/App.jsx, halaman publik, backend/routes/api.php, AuthController, BuyerProfileController, ConsultationController.&#10;Disusun berdasarkan kode aplikasi pada 12 Oktober 2026." style="text;whiteSpace=wrap;html=0;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
