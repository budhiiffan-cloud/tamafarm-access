        </mxCell>
        <mxCell id="47" value="Garis putus-putus = relasi logis, bukan foreign key database.&#10;&#10;personal_access_tokens menggunakan pasangan tokenable_type + tokenable_id. Pada akun aplikasi, token mengacu ke model User.&#10;&#10;sessions.user_id hanya nullable dan berindeks pada migration; tidak didefinisikan constrained().&#10;&#10;firebase_devices.session_id mengacu ke personal_access_tokens.id, bukan sessions.id. users pada halaman ini adalah tabel yang sama seperti halaman 01." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#713f12;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="650" y="690" width="1010" height="295" as="geometry" />
        </mxCell>
        <mxCell id="48" value="PK = primary key   |   FK = foreign key database   |   UQ = unique   |   ? = nullable   |   LOG = relasi logis (tanpa constraint FK)&#10;Label kardinalitas dibaca dari tabel sumber ke tabel tujuan: 1 : 0..N, 1 : 0..1, atau 0..1 : 0..N.&#10;Sumber: seluruh migration backend/database/migrations hingga 11 Oktober 2026; bukan hasil inspeksi database yang sedang berjalan." style="text;whiteSpace=wrap;html=0;fontSize=14;fontColor=#475569;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1720" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
