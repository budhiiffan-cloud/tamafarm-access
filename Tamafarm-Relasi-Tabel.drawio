        <mxCell id="132" value="Aturan penting&#10;• pelanggan.id_user nullable + unique: satu akun maksimal satu profil pelanggan; tamu boleh tanpa akun.&#10;• pengiriman.id_pesanan unique: satu pesanan maksimal satu pengiriman.&#10;• pesanan dan produk berelasi M:N melalui detail_pesanan.&#10;• DB mengizinkan pesanan belum memiliki detail; aplikasi mewajibkan minimal satu item saat membuat pesanan." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#713f12;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1770" width="420" height="275" as="geometry" />
        </mxCell>
        <mxCell id="133" value="PK = primary key   |   FK = foreign key database   |   UQ = unique   |   ? = nullable   |   LOG = relasi logis (tanpa constraint FK)&#10;Label kardinalitas dibaca dari tabel sumber ke tabel tujuan: 1 : 0..N, 1 : 0..1, atau 0..1 : 0..N.&#10;Sumber: seluruh migration backend/database/migrations hingga 11 Oktober 2026; bukan hasil inspeksi database yang sedang berjalan." style="text;whiteSpace=wrap;html=0;fontSize=14;fontColor=#475569;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2090" width="1720" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
